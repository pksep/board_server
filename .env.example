PORT=3000
HOST=127.0.0.1
ALLOWED_ORIGIN=*
BOARD_SOCKET_PATH=/api/socket.io
DATABASE_URL=postgresql://postgres:board-local-password@localhost:5432/board

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=board
MINIO_PUBLIC_BASE_URL=http://localhost:9002
MINIO_LOCAL_BASE_URL=http://localhost:9002
MINIO_PATH_STYLE=true

PRIVATE_KEY=secret_key_safasa_instance1
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
ADMIN_PASSWORD=admin
APPLICATION_TYPE=backend
INIT_SEP=true

ERP_CLIENT_OFFLINE_HOST=http://localhost:5173
COMMENTS_SERVICE_URL=http://localhost:3001
ERP_API_URL=http://localhost:8026

MCP_PROJECTS_AUDIENCE=http://localhost:3000/mcp/projects
MCP_PROJECTS_RESOURCE_URL=http://localhost:3000/mcp/projects
MCP_PROJECTS_INTROSPECTION_URL=
